{
  "name": "smartpilot-gateway",
  "version": "0.5.0",
  "private": true,
  "description": "SmartPilot Gateway: Alexa-Adapter, Action-Routing, LLM- und MCP-Orchestrierung, Admin-UI",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint src test",
    "deadcode": "knip",
    "dupes": "jscpd src web --threshold 3",
    "cycles": "madge --circular --extensions ts src",
    "coverage": "node --import tsx --experimental-test-coverage --test-coverage-exclude='web/**' --test-coverage-lines=97 --test-coverage-branches=84 --test-coverage-functions=94 --test test/*.test.ts",
    "gates": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run deadcode && npm run cycles && npm run dupes && npm run audit:gate",
    "gates:all": "npm run typecheck; npm run typecheck:tests; npm run lint; npm run deadcode; npm run cycles; npm run dupes; npm run audit:gate",
    "audit:gate": "node --import tsx scripts/audit-gate.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "mcp-searxng": "^2.5.0",
    "mqtt": "^5.16.1",
    "nunjucks": "^3.2.4",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "madge": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "ip-address": "^10.7.3"
  }
}
