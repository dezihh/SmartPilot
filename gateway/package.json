{
  "name": "smartpilot-gateway",
  "version": "0.4.0",
  "private": true,
  "description": "SmartPilot Gateway: Alexa-Adapter, Action-Routing, LLM- und MCP-Orchestrierung, Admin-UI",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint src test",
    "deadcode": "knip",
    "dupes": "jscpd src web --threshold 3",
    "cycles": "madge --circular --extensions ts src",
    "coverage": "node --import tsx --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 --test test/*.test.ts",
    "gates": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run deadcode && npm run cycles && npm run dupes",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mcp-searxng": "^2.5.0",
    "nunjucks": "^3.2.4",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.10",
    "@types/nunjucks": "^3.2.6",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "madge": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "ip-address": "^10.7.3"
  }
}
