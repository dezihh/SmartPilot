# ============================================================================
# SmartPilot Gateway - Vorlage fuer die Laufzeit-Konfiguration (.env)
# Kopieren nach .env und ausfuellen. Werte hier sind Platzhalter bzw. Defaults.
# Regel: Hier steht nur, was der Prozess zum Starten braucht. Betriebswerte
# (Modell-Tuning, Tool-Runden, HTTP-Grenzen) stehen in der Admin-UI unter
# Grundeinstellungen - fuer sie gibt es bewusst keine Umgebungsvariable.
# ============================================================================

# --------------------------------------------------------------- MUST HAVE
# Admin-Login der Weboberflaeche. Mind. 24 Zeichen, muss sich von API_TOKEN
# unterscheiden, sonst bricht der Start ab.
ADMIN_TOKEN=change-me-admin-mindestens-24-zeichen

# Token der Adapter-API (Alexa-Lambda: /api/query). Mind. 24 Zeichen.
API_TOKEN=change-me-api-mindestens-24-zeichen

# OpenAI-kompatible LLM-Schnittstelle mit Tool-Calling, endet auf /v1.
# Beispiel: LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=https://api.example.org/v1
LLM_API_KEY=change-me

# Modell fuer alle LLM-Aufrufe. Wechsel = Container neu starten.
# Beispiel: LLM_MODEL=gpt-4o-mini
LLM_MODEL=change-me

# ------------------------------------------------------- INSTALLATION
# SQLite-Datei. Default: ./data/smartpilot.db
# DB_PATH=./data/smartpilot.db

# Anzahl Proxy-Hops (nginx davor). Ohne Wert sieht das Gateway nur die
# Proxy-IP und das Login-Rate-Limit gilt global statt pro Client.
# TRUST_PROXY=1

# ----------------------------------------------------------------- CAN HAVE
# Zeitzone fuer Template-"now" und Log-Zeitstempel. Default: Europe/Berlin
# TZ=Europe/Berlin

# Skill-ID aus der Alexa-Konsole; ohne Wert keine Skill-Pruefung.
# ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000

# Eigenes Modell nur fuer Router-/Werkzeugrunden. Leer = wie LLM_MODEL.
# TOOL_MODEL=

# Sub-Pfad hinter einem Reverse-Proxy, z. B. /smartpilot
# BASE_PATH=

# Log-Detailgrad: debug | info | warn | error. Default: info
# LOG_LEVEL=info

# Paket-Registry; leer = GitHub main. Fuer Tests auf einen Branch zeigen.
# PACKAGES_REGISTRY_URL=

# Replay-Schutz der Adapter-API (HMAC). Gesetzt = jede /api/*-Anfrage braucht
# X-Timestamp, X-Nonce und X-Signature; die Lambda muss dasselbe Secret kennen.
# API_SIGNING_SECRET=
# API_SIGNATURE_TTL_SECONDS=300

# Grenzen und Rate-Limits (Werte = Code-Default)
# QUERY_RATE_MAX=30        # Anfragen/Minute an /api/query
# QUERY_MAX_CHARS=500      # maximale Laenge einer Frage
# ADMIN_RATE_MAX=240       # Anfragen/Minute an Admin-API und /metrics (eigene Buckets, pro Client-IP)
# SESSION_MAX_HOURS=24     # Lebensdauer einer Chat-Session

# Rueckfrage-Budget des Agenten pro Vorgang. Default: 2
# AGENT_CLARIFICATION_BUDGET=2

# MCP-Startverhalten
# MCP_INIT_TIMEOUT_MS=15000
# MCP_FAILURE_TTL_MS=30000
# MCP_MODULES_DIR=         # Ablage installierter stdio-Server (Default: data/mcp_modules)
# MCP_NPM_ALLOW_SCRIPTS=   # 1 = npm-Skripte bei Installation erlauben

# LLM warmhalten (0 = aus). Erzeugt regelmaessige Mini-Anfragen.
# LLM_KEEPALIVE_MS=0

# Beispieldaten beim Erststart: nur wenn noch keine Datenbank existiert.
# 'example' legt Wetter (Berlin) und den Vorgang "Laufzeit" an; 'none' startet
# leer. Ohne Eintrag gilt 'example'.
# SEED_PROFILE=example
