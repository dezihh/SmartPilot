# Gateway-Konfiguration: nach gateway/.env kopieren und befuellen.
# Pflichtwerte: ohne ADMIN_TOKEN, API_TOKEN, LLM_BASE_URL, LLM_API_KEY und
# LLM_MODEL startet der Prozess nicht.

# --- Pflicht ---
# Langes, zufaelliges Token; schuetzt NUR den Admin-Bereich (/admin/**).
ADMIN_TOKEN=change-me-lange-zufaellige-zeichenkette
# Getrenntes Token; schuetzt NUR die Adapter-API (/api/query, /api/lambda-trace).
# Muss sich von ADMIN_TOKEN unterscheiden (die Alexa-Lambda nutzt es).
API_TOKEN=change-me-anderes-langes-zufaelliges-token
# OpenAI-kompatible Chat-Completions-Schnittstelle (mit Tool-Calling).
LLM_BASE_URL=http://llm.example.org:8000/v1
LLM_API_KEY=change-me
# Name des LLM-Modells am Endpunkt (muss Tool-Calling unterstuetzen).
LLM_MODEL=chat-fast

# --- Optional (Defaults in Klammern) ---
PORT=3000                          # Gateway-Port im Container (3000)
DB_PATH=./data/smartpilot.db       # SQLite-Datei (./data/smartpilot.db)
LLM_MAX_TOKENS=2000                # Ausgabe-Budget (2000)
LLM_REASONING_EFFORT=              # z. B. low/medium/high, falls Unterstuetzt
LLM_TOOL_DEADLINE_MS=9000          # Tool-Runden-Budget (9000)
MAX_TOOL_ITERATIONS=6              # max. Tool-Iterationen (6)
AGENT_CLARIFICATION_BUDGET=2       # max. Rueckfragen des Agenten (2)
LLM_KEEPALIVE_MS=120000            # Modell warm halten (120000; 0 = aus)
BASE_PATH=                         # Admin-Pfad-Prefix (leer = /admin); z. B. /smartpilot
TRUST_PROXY=                       # hinter Reverse-Proxy: Hops z. B. 1 (leer = aus)
QUERY_MAX_CHARS=500                # max. Zeichen fuer /api/query (500)
QUERY_RATE_MAX=30                  # max. Anfragen/Minute fuer /api/query (30)
ALEXA_SKILL_ID=                    # erwartete Skill-ID (optional; Header-Log, keine Sicherheitsgrenze)
SESSION_MAX_HOURS=24               # absolute Obergrenze einer Admin-Session (24)

# --- Nur Compose-Host-Mapping (der Code liest PORT) ---
# GATEWAY_PORT=8331
# Bind-Adresse des Host-Ports. Default des Compose: 127.0.0.1 (nur lokal).
# Erreicht ein Reverse-Proxy das Gateway ueber das Netz (andere Maschine/Container),
# hier die NIC/IP setzen, sonst liefert nginx 502: GATEWAY_BIND=0.0.0.0
# GATEWAY_BIND=192.168.10.2
