# Vorlage fuer den Betrieb mit dem fertigen Image (compose.release.yaml).
# Kopieren nach .env und ausfuellen. Die Image-Version steht in der Compose
# selbst; eigene Anpassungen gehoeren in docker-compose.override.yml.

# Pflichtwerte: lang, zufaellig und untereinander verschieden.
# Mindestens 24 Zeichen; in Produktion bricht der Start sonst ab.
ADMIN_TOKEN=change-me-admin-mindestens-24-zeichen
API_TOKEN=change-me-api-mindestens-24-zeichen

# OpenAI-kompatible LLM-Schnittstelle mit Tool-Calling.
LLM_BASE_URL=https://llm.example.org/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me

# Optional (Beispiele, Defaults greifen ohne Eintrag):
# DB_PATH=./data/smartpilot.db
# TRUST_PROXY=1
# BASE_PATH=/smartpilot
# PACKAGES_REGISTRY_URL=https://raw.githubusercontent.com/dezihh/SmartPilot/main/packages
